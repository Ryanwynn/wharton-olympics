# ─────────────────────────────────────────────────────────────────────────────
# Wharton Student Olympics — environment
# Copy to .env.local for local dev. Nothing here is required to run locally:
# with no DATABASE_URL the app uses an embedded PGlite database under ./.pgdata.
# ─────────────────────────────────────────────────────────────────────────────

# Production Postgres (Neon). Use the POOLED connection string (PgBouncer,
# transaction mode) per spec §9.2. Leave unset locally to use embedded PGlite.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/olympics?sslmode=require

# Server secret for HMAC-SHA256 hashing of verification codes and session tokens.
# Generate: `openssl rand -hex 32`. A dev default is used if unset (do NOT ship without this).
AUTH_SECRET=dev-only-insecure-secret-change-me

# First admin(s), comma-separated. Seeded at deploy; all later grants happen in-app. (§3)
SEED_ADMIN_EMAILS=admin@wharton.upenn.edu

# Email eligibility allowlist (§5.2). Comma-separated. Defaults to all Penn schools.
ALLOWED_EMAIL_DOMAINS=upenn.edu,wharton.upenn.edu,seas.upenn.edu,sas.upenn.edu,law.upenn.edu,nursing.upenn.edu,gse.upenn.edu,design.upenn.edu,vet.upenn.edu,pennmedicine.upenn.edu

# Participant session lifetime in days (§5.5). Privileged sessions step down to 12h in code.
SESSION_TTL_DAYS=30

# Mailer: "console" (dev — prints & surfaces the code) or "ses" (prod). (§11)
MAILER=console
# SES config (only when MAILER=ses):
# AWS_REGION=us-east-1
# SES_FROM=Wharton Olympics <noreply@olympics.example.org>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Organizer contact shown on the "didn't get a code?" fallback (§11).
ORGANIZER_CONTACT_EMAIL=olympics@wharton.upenn.edu
