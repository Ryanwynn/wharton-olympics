# ─────────────────────────────────────────────────────────────────────────────
# Wharton Student Olympics — environment
# Copy to .env.local for local dev. Nothing here is required to run locally:
# with no DATABASE_URL the app uses an embedded PGlite database under ./.pgdata,
# and with no GOOGLE_CLIENT_ID the /signin page exposes a dev-only login.
# ─────────────────────────────────────────────────────────────────────────────

# Production Postgres (Neon). Use the POOLED connection string (PgBouncer,
# transaction mode) per spec §9.2. Leave unset locally to use embedded PGlite.
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/olympics?sslmode=require

# Server secret for HMAC-SHA256 hashing of session tokens.
# Generate: `openssl rand -hex 32`. A dev default is used if unset (do NOT ship without this).
AUTH_SECRET=dev-only-insecure-secret-change-me

# First admin(s), comma-separated. Flagged as admin on their first sign-in. (§3)
SEED_ADMIN_EMAILS=admin@wharton.upenn.edu

# Allowed sign-in domains (checked against the Google account's email). Comma-
# separated. Default includes penn.edu / wharton.penn.edu AND the real Penn
# domains (upenn.edu family). Tighten this to exactly what your students use.
# ALLOWED_EMAIL_DOMAINS=penn.edu,wharton.penn.edu,upenn.edu,wharton.upenn.edu

# ── Google OAuth ("Sign in with Google") ─────────────────────────────────────
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console.
# Authorized redirect URI must be  <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL, used to build the OAuth redirect URI (must match Google exactly).
# APP_URL=https://whartonolympics.com

# Participant session lifetime in days (§5.5). Privileged sessions step down to 12h in code.
SESSION_TTL_DAYS=30
